# Copy to .env.local and fill in your Supabase project's values.
# The publishable (anon) key is safe to expose to browsers; row access is
# controlled by Row Level Security policies in supabase/schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: a cookieless usage counter. Both unset and the site counts nothing
# — see src/lib/analytics.js for the values each provider needs. Set these in
# the repo's Actions *variables*, not its secrets: they end up in the bundle,
# which is the point.
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_ATTR=
