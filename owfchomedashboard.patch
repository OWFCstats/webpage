+  letter-spacing: 0.11em;
+  text-transform: uppercase;
+  color: #8e8b83;
+}
+
+.home-kpi .k-value {
+  display: block;
+  margin-top: 0.3rem;
+  font-size: 1.7rem;
+  font-weight: 800;
+  line-height: 1.05;
+  letter-spacing: -0.02em;
+  color: #fff;
+  font-variant-numeric: tabular-nums;
+}
+
+.home-kpi .k-sub {
+  display: block;
+  margin-top: 0.2rem;
+  font-size: 0.72rem;
+  font-weight: 600;
+  color: #9a978e;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* Two independent stacks rather than one grid with shared rows: a short
+   widget beside a tall one would otherwise leave a dead gap under it until
+   the next row started. */
+.home-grid {
+  display: grid;
+  grid-template-columns: 1.7fr 1fr;
+  gap: 1rem;
+  align-items: start;
+}
+
+.home-col {
+  display: flex;
+  flex-direction: column;
+  gap: 1rem;
+  min-width: 0;
+}
+
+/* Grid items default to min-width:auto, so a wide table inside one would push
+   the whole track past the viewport and .table-wrap's overflow never engages. */
+.home-grid > * { min-width: 0; }
+
+.home-widget { padding: 1.05rem 1.15rem 1.2rem; }
+
+.home-widget-head {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 0.8rem;
+  margin-bottom: 0.85rem;
+}
+
+.home-widget-head h2 { font-size: 1.02rem; margin: 0; }
+
+.home-eyebrow {
+  display: block;
+  font-size: 0.62rem;
+  font-weight: 800;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: #2d6f96;
+  margin-bottom: 0.15rem;
+}
+
+.home-widget-note { font-size: 0.78rem; white-space: nowrap; }
+
+.home-widget .more {
+  font-size: 0.78rem;
+  font-weight: 700;
+  color: var(--gold-deep);
+  white-space: nowrap;
+}
+
+.home-widget .more:hover { text-decoration: underline; }
+
+/* ---- league table widget ---- */
+
+table.data.league-table td.lt-pos,
+table.data.league-table th.lt-pos {
+  text-align: center;
+  font-weight: 800;
+  color: var(--ink-soft);
+  width: 2rem;
+}
+
+table.data.league-table td.lt-club { font-weight: 700; }
+table.data.league-table td.lt-pts { font-weight: 800; color: var(--black); }
+table.data.league-table td.lt-gd { color: var(--ink-soft); }
+
+table.data.league-table tr.lt-us { background: rgba(227, 180, 33, 0.1); }
+table.data.league-table tr.lt-us td.lt-pos { color: var(--gold-deep); }
+table.data.league-table tr.lt-us:hover { background: rgba(227, 180, 33, 0.14); }
+
+.lt-form { display: inline-flex; gap: 3px; margin-left: 0.5rem; vertical-align: middle; }
+
+.lt-dot { width: 6px; height: 6px; border-radius: 50%; display: inline-block; }
+.lt-dot.W { background: var(--green); }
+.lt-dot.D { background: #a3a6ad; }
+.lt-dot.L { background: var(--red); }
+
+/* Placeholder until a standings source exists. The ghost rows show the shape
+   the widget will take, so the space doesn't read as a rendering failure. */
+.lt-placeholder { text-align: center; padding: 0.4rem 0 0.2rem; }
+
+.lt-placeholder-art {
+  display: flex;
+  flex-direction: column;
+  gap: 0.45rem;
+  margin-bottom: 1rem;
+}
+
+.lt-ghost-row {
+  display: flex;
+  align-items: center;
+  gap: 0.6rem;
+  padding: 0.3rem 0.5rem;
+  border-radius: 7px;
+}
+
+.lt-ghost-row.lt-ghost-us { background: rgba(227, 180, 33, 0.13); }
+
+.lt-ghost-pos {
+  width: 14px;
+  height: 8px;
+  border-radius: 3px;
+  background: #e0ddd3;
+  flex: none;
+}
+
+.lt-ghost-bar {
+  height: 8px;
+  border-radius: 4px;
+  background: #e9e6dc;
+}
+
+.lt-ghost-row.lt-ghost-us .lt-ghost-bar { background: rgba(184, 134, 11, 0.35); }
+
+.lt-ghost-pts {
+  width: 20px;
+  height: 8px;
+  border-radius: 3px;
+  background: #e0ddd3;
+  margin-left: auto;
+  flex: none;
+}
+
+.lt-placeholder-title {
+  font-weight: 800;
+  color: var(--black);
+  margin: 0 0 0.25rem;
+}
+
+.lt-placeholder-copy { max-width: 46ch; margin: 0 auto; }
+
+/* ---- next fixture widget ---- */
+
+.fixture-teams {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 0.5rem;
+}
+
+.fixture-side {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 0.45rem;
+  flex: 1;
+  min-width: 0;
+}
+
+.fixture-badge {
+  width: 44px;
+  height: 44px;
+  border-radius: 50%;
+  display: grid;
+  place-items: center;
+  font-weight: 800;
+  font-size: 0.78rem;
+  flex: none;
+}
+
+.fixture-badge.us { background: var(--gold); color: var(--black); }
+.fixture-badge.them { background: #2a2d34; color: #cfccc2; }
+
+.fixture-team {
+  font-size: 0.8rem;
+  font-weight: 700;
+  text-align: center;
+  line-height: 1.3;
+}
+
+a.fixture-team:hover { color: var(--gold-deep); }
+
+.fixture-vs {
+  font-size: 0.72rem;
+  font-weight: 800;
+  color: var(--ink-soft);
+  text-transform: uppercase;
+  letter-spacing: 0.06em;
+  padding-top: 1rem;
+}
+
+.fixture-meta {
+  margin-top: 0.9rem;
+  padding-top: 0.75rem;
+  border-top: 1px solid var(--line);
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25rem 1rem;
+  font-size: 0.82rem;
+  color: var(--ink-soft);
+}
+
+.fixture-meta strong { color: var(--ink); }
+
+.fixture-countdown {
+  display: inline-block;
+  margin-top: 0.7rem;
+  padding: 0.25rem 0.65rem;
+  border-radius: 999px;
+  background: rgba(91, 163, 201, 0.16);
+  color: #2d6f96;
+  font-size: 0.74rem;
+  font-weight: 800;
+}
+
+/* ---- recent form widget ---- */
+
+.home-form-list {
+  list-style: none;
+  margin: 0.9rem 0 0;
+  padding: 0;
+  font-size: 0.85rem;
+}
+
+.home-form-list li {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.7rem;
+  padding: 0.35rem 0;
+  border-bottom: 1px solid var(--line);
+}
+
+.home-form-list li:last-child { border-bottom: none; }
+.home-form-list a { font-weight: 600; min-width: 0; }
+.home-form-list a:hover { color: var(--gold-deep); }
+
+.home-form-list strong {
+  white-space: nowrap;
+  font-variant-numeric: tabular-nums;
+}
+
+.home-spark {
+  display: block;
+  width: 100%;
+  height: 40px;
+  margin-top: 0.9rem;
+}
+
+.home-spark-note { font-size: 0.72rem; margin: 0.25rem 0 0; }
+
+/* ---- top scorer widget ---- */
+
+.scorer-row { display: flex; align-items: center; gap: 0.85rem; }
+
+.scorer-avatar {
+  width: 48px;
+  height: 48px;
+  border-radius: 50%;
+  background: var(--black);
+  color: var(--gold);
+  display: grid;
+  place-items: center;
+  font-weight: 800;
+  font-size: 0.95rem;
+  flex: none;
+}
+
+.scorer-who { min-width: 0; }
+
+.scorer-name {
+  display: block;
+  font-size: 1.1rem;
+  font-weight: 800;
+  color: var(--black);
+  line-height: 1.25;
+}
+
+.scorer-name:hover { color: var(--gold-deep); }
+.scorer-who .muted { display: block; font-size: 0.8rem; }
+
+.scorer-tally { margin-left: auto; text-align: right; flex: none; }
+
+.scorer-tally b {
+  display: block;
+  font-size: 1.9rem;
+  font-weight: 800;
+  line-height: 1;
+  color: var(--gold-deep);
+  font-variant-numeric: tabular-nums;
+}
+
+.scorer-tally em {
+  font-style: normal;
+  font-size: 0.6rem;
+  font-weight: 800;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--ink-soft);
+}
+
+.scorer-foot { margin: 0.7rem 0 0; font-size: 0.8rem; }
+
+/* ---- season stats widget ---- */
+
+.home-stats { margin-top: 1rem; }
+
+.home-stats-body { display: flex; flex-direction: column; gap: 1rem; }
+
+.home-stat-tiles {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 0.6rem;
+}
+
+.home-stat-tile {
+  background: #faf9f5;
+  border: 1px solid var(--line);
+  border-radius: 10px;
+  padding: 0.6rem 0.5rem;
+  text-align: center;
+}
+
+.home-stat-tile b {
+  display: block;
+  font-size: 1.3rem;
+  font-weight: 800;
+  line-height: 1;
+  color: var(--black);
+  font-variant-numeric: tabular-nums;
+}
+
+.home-stat-tile em {
+  font-style: normal;
+  display: block;
+  margin-top: 0.3rem;
+  font-size: 0.6rem;
+  font-weight: 700;
+  letter-spacing: 0.07em;
+  text-transform: uppercase;
+  color: var(--ink-soft);
+}
+
+.home-bars { display: flex; flex-direction: column; gap: 0.55rem; }
+
+.home-bar { display: flex; align-items: center; gap: 0.6rem; font-size: 0.82rem; }
+
+.home-bar-label {
+  width: 68px;
+  flex: none;
+  font-weight: 700;
+  color: var(--ink-soft);
+  white-space: nowrap;
+}
+
+.home-bar-track {
+  flex: 1;
+  height: 10px;
+  border-radius: 5px;
+  background: #eceadf;
+  overflow: hidden;
+}
+
+.home-bar-fill {
+  display: block;
+  height: 100%;
+  border-radius: 5px;
+  transition: width 0.4s ease;
+}
+
+.home-bar-fill.gf { background: var(--gold); }
+.home-bar-fill.ga { background: var(--blue); }
+
+.home-bar-value {
+  width: 26px;
+  flex: none;
+  text-align: right;
+  font-weight: 800;
+  color: var(--black);
+  font-variant-numeric: tabular-nums;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .home-bar-fill { transition: none; }
+}
+
+@media (min-width: 760px) {
+  .home-stats-body { flex-direction: row; align-items: center; gap: 2.2rem; }
+  .home-stat-tiles { flex: none; width: 42%; }
+  .home-bars { flex: 1; }
+}
+
+/* ---- section cards ---- */
+
+.home-sections {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: 1rem;
+  margin-top: 1rem;
+}
+
+.home-section-card {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  padding: 0.95rem 1rem;
+  transition: transform 0.12s ease, border-color 0.12s ease;
+}
+
+.home-section-card:hover {
+  transform: translateY(-2px);
+  border-color: var(--gold);
+}
+
+.home-section-icon {
+  width: 38px;
+  height: 38px;
+  border-radius: 10px;
+  flex: none;
+  display: grid;
+  place-items: center;
+  background: rgba(91, 163, 201, 0.16);
+  color: #2d6f96;
+}
+
+.home-section-icon svg {
+  width: 19px;
+  height: 19px;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1.3;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+
+.home-section-text { min-width: 0; }
+
+.home-section-text strong {
+  display: block;
+  font-size: 0.95rem;
+  color: var(--black);
+}
+
+.home-section-text .muted { font-size: 0.76rem; line-height: 1.35; }
+
+/* ---- home: narrow layouts ---- */
+
+@media (max-width: 900px) {
+  .home-grid { grid-template-columns: 1fr; }
+
+  /* The wrappers stop being boxes so their widgets become grid items in one
+     column — which is what lets the fixture jump above the table on a phone
+     while the desktop two-stack layout stays intact. */
+  .home-col { display: contents; }
+
+  .home-next { order: 1; }
+  .home-table { order: 2; }
+  .home-form { order: 3; }
+  .home-scorer { order: 4; }
+
+  .home-sections { grid-template-columns: repeat(2, 1fr); }
+}
+
+@media (max-width: 700px) {
+  .home-kpis { grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }
+  .home-kpi { padding: 0.75rem 0.85rem 0.7rem; }
+  .home-kpi .k-value { font-size: 1.4rem; }
+  .home-grid { gap: 0.8rem; }
+  .home-stats { margin-top: 0.8rem; }
+  .home-sections { gap: 0.7rem; margin-top: 0.8rem; }
+  .home-widget { padding: 0.95rem 1rem 1.05rem; }
+  .home-head { margin-bottom: 0.9rem; }
+}
+
+@media (max-width: 420px) {
+  .home-sections { grid-template-columns: 1fr; }
+}
